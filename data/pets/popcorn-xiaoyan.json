  },
  "forms": [
    {
      "id": "boar",
      "name": {
        "en": "Round boar form",
        "zh-CN": "圆胖野猪形态"
      },
      "description": {
        "en": "A compact desktop-pet form for grumpy idling, trotting, hoof greetings, jumps, waiting, and focused inspection.",
        "zh-CN": "适合桌宠使用的紧凑形态，用于臭脸待机、小跑、抬蹄打招呼、跳跃、等待和专注观察。"
      }
    }
